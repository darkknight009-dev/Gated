# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only Supabase service credential
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public application origin; must match Supabase redirect allowlist
APP_URL=http://localhost:3000

# 32 random bytes encoded as base64url
OAUTH_ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64URL_SECRET

# Same Google OAuth client configured in Supabase Auth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gated-gmail
GOOGLE_PUBSUB_VERIFICATION_TOKEN=GENERATE_A_STRONG_RANDOM_SECRET

# Worker authentication
CRON_SECRET=GENERATE_A_DIFFERENT_STRONG_RANDOM_SECRET

# NVIDIA AI provider
NVIDIA_API_KEY=
NVIDIA_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,openai/gpt-oss-20b,deepseek-ai/deepseek-v4-flash,z-ai/glm-5.2
