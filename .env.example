# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only Supabase service credential
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public application origin; must match the Supabase redirect allowlist.
# Production must be the real HTTPS origin (for example https://gated-swart.vercel.app).
# In production a loopback value is ignored and the request host is used instead.
APP_URL=http://localhost:3000

# 32 random bytes encoded as base64url
OAUTH_ENCRYPTION_KEY=GENERATE_A_32_BYTE_BASE64URL_SECRET

# Same Google OAuth client configured in Supabase Auth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gated-gmail
GOOGLE_PUBSUB_VERIFICATION_TOKEN=GENERATE_A_STRONG_RANDOM_SECRET

# Worker authentication
CRON_SECRET=GENERATE_A_DIFFERENT_STRONG_RANDOM_SECRET

# NVIDIA AI provider
# Models are tried in order; retired (410) or unknown (404) models fall through to the next.
# Verify with `npm run check:models` — a slow or truncating model silently disables AI
# enrichment. Order the list fastest first.
NVIDIA_API_KEY=
NVIDIA_MODELS=openai/gpt-oss-20b,mistralai/mistral-nemotron
# Per-attempt request timeout. Reasoning models can need longer than a plain instruct model.
NVIDIA_TIMEOUT_MS=60000
# Completion budget. Too small a value truncates the JSON answer for reasoning models,
# which surfaces as invalid output rather than a clear error.
NVIDIA_MAX_TOKENS=4096
